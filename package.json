{
  "name": "bots",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.ts",
    "dev": "pnpm --recursive --parallel --stream run dev",
    "build": "pnpm --recursive run build",
    "start": "node --env-file=.env.local apps/orchestrator/src/main.ts",
    "typecheck": "pnpm --recursive run typecheck && tsc --project tsconfig.json",
    "test": "pnpm --recursive run test",
    "verify:auth": "pnpm build && node scripts/verify-auth.ts",
    "verify:agent": "pnpm build && node scripts/verify-agent.ts",
    "verify:tailnet": "node scripts/verify-tailnet.ts",
    "verify:template": "node scripts/verify-template.ts",
    "verify:browser": "node scripts/verify-browser.ts"
  },
  "devDependencies": {
    "@bots/convex": "workspace:*",
    "@bots/protocol": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "convex": "catalog:",
    "jose": "catalog:",
    "typescript": "catalog:",
    "ws": "catalog:"
  }
}
