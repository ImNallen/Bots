[Unit]
Description=Deploy the newest commit on main that passed CI
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/bots
Environment=HOME=/root DEPLOY_BY_TIMER=1
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 0 /run/lock/bots-deploy.lock /usr/local/bin/node /opt/bots/scripts/autodeploy.ts
TimeoutStartSec=30min
